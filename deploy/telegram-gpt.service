[Unit]
Description=Telegram GPT Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=telegram-gpt
Group=telegram-gpt
WorkingDirectory=/opt/telegram-gpt
EnvironmentFile=/etc/telegram-gpt/bot.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=STATE_DB_PATH=/var/lib/telegram-gpt/bot.db
ExecStart=/opt/telegram-gpt/.venv/bin/python /opt/telegram-gpt/bot.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
StateDirectory=telegram-gpt
StateDirectoryMode=0700

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
