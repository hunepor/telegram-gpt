TELEGRAM_BOT_TOKEN=put_your_telegram_bot_token_here
OPENAI_API_KEY=put_your_openai_api_key_here

# Можно оставить как есть или заменить на другую доступную вам модель.
OPENAI_MODEL=gpt-4.1-mini

# Детализация обработки фото: low дешевле, high точнее, auto на усмотрение OpenAI.
IMAGE_DETAIL=low

# Оплата Telegram Stars. По умолчанию выключена, чтобы обновление не заблокировало старый запуск.
PAYMENTS_ENABLED=false
STATE_DB_PATH=bot-state.sqlite3

# Админы могут управлять бесплатным списком через /allow, /unallow и /freeusers.
# Узнать свой id можно командой /id.
ADMIN_USER_IDS=

# Начальный бесплатный список. Эти id будут добавлены в SQLite при запуске.
FREE_USER_IDS=

# Пакет оплаты: цена в Stars и сколько кредитов начислить.
STARS_PRICE=50
CREDITS_PER_PURCHASE=50

# Стоимость запросов в кредитах.
TEXT_REQUEST_CREDITS=1
IMAGE_REQUEST_CREDITS=2

# Текст ответа на /paysupport.
PAYMENT_SUPPORT_TEXT=По вопросам оплат напишите владельцу бота.

# Сколько последних сообщений хранить в памяти одного диалога.
MAX_HISTORY_MESSAGES=12

# Caveman-режим отправляет в OpenAI меньше истории и просит отвечать короче.
ECONOMY_HISTORY_MESSAGES=4

# Ограничения на длину ответов. Это помогает контролировать расход выходных токенов.
MAX_OUTPUT_TOKENS=900
ECONOMY_MAX_OUTPUT_TOKENS=250

# Старые сообщения периодически сжимаются в краткое резюме.
SUMMARY_ENABLED=true
SUMMARY_MODEL=gpt-4.1-mini
SUMMARY_BATCH_MESSAGES=6
SUMMARY_MAX_CHARS=900
SUMMARY_MAX_OUTPUT_TOKENS=220

# Очень длинные сообщения в памяти хранятся в сокращенном виде.
MAX_STORED_MESSAGE_CHARS=1400

# Необязательно: настройте характер ответов бота.
SYSTEM_PROMPT=Ты полезный ассистент в Telegram. Отвечай понятно, дружелюбно и по делу.

# Необязательно: отдельный стиль caveman-режима.
ECONOMY_SYSTEM_PROMPT=Ты полезный ассистент в Telegram в режиме caveman. Отвечай максимально кратко и по делу.
