TELEGRAM_BOT_TOKEN=put_your_telegram_bot_token_here
OPENAI_API_KEY=put_your_openai_api_key_here

# Можно оставить как есть или заменить на другую доступную вам модель.
OPENAI_MODEL=gpt-4.1-mini

# Сколько последних сообщений хранить в памяти одного диалога.
MAX_HISTORY_MESSAGES=12

# Необязательно: настройте характер ответов бота.
SYSTEM_PROMPT=Ты полезный ассистент в Telegram. Отвечай понятно, дружелюбно и по делу.
